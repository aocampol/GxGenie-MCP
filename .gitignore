# `config.example.json` / `config.multi.example.json`.
config.json
config.test.json
config.local.json

# ---- R&D / reverse-engineering (puede contener exports reales de KBs) ----
**/probes/

# ---- Documentación interna (notas de fases, prompts, etc.) ----
docs/

# ---- IDE / editor ----
.vs/
.vscode/
.idea/
.claude/
*.user
*.suo
*.userprefs
*.DotSettings.user

# ---- OS ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Misc ----
*.swp
*.tmp
*.bak
