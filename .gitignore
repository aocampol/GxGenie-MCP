# ---- Build artifacts (.NET) ----
**/bin/
**/obj/
*.pdb
*.dll
*.exe

# ---- Runtime / local state ----
audit*.log
setup_log.txt
backups/
backups-*/

# ---- Local config (paths absolutos del usuario) ----
